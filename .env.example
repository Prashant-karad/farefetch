# Copy this file to .env and fill in real values.
# .env is git-ignored; this example file is committed so others know what's needed.

DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/agentgate
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development


INTERNAL_TOKEN=generate-a-long-random-string
PLATFORM_URL=http://127.0.0.1:8001
ORIGIN_URL=http://127.0.0.1:8002
DEMO_AGENT_API_KEY=printed-by-the-seed-scriptPASS_PRIVATE_KEY_PATH=/path/to/pass_private.pem
PASS_PUBLIC_KEY_PATH=/path/to/pass_public.pem

PAYPAL_CLIENT_ID=from-developer.paypal.com
PAYPAL_CLIENT_SECRET=from-developer.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PUBLIC_BASE_URL=https://your-public-platform-url
