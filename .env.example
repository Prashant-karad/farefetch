# Copy to .env and fill in real values. .env is git-ignored.

# --- Infrastructure ---
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/agentgate
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development

# --- Service URLs (local) ---
PLATFORM_URL=http://127.0.0.1:8001
ORIGIN_URL=http://127.0.0.1:8002
GATEWAY_URL=http://127.0.0.1:8000

# --- Secrets ---
INTERNAL_TOKEN=generate-a-long-random-string
DEMO_AGENT_API_KEY=printed-by-the-seed-script

# --- Signing keys: file paths locally (make keys), or PEM text when hosting ---
PASS_PRIVATE_KEY_PATH=/workspaces/farefetch/keys/pass_private.pem
PASS_PUBLIC_KEY_PATH=/workspaces/farefetch/keys/pass_public.pem
# PASS_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"
# PASS_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials; use a US business account) ---
PAYPAL_CLIENT_ID=from-developer.paypal.com
PAYPAL_CLIENT_SECRET=from-developer.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PUBLIC_BASE_URL=https://your-public-platform-url
PUBLISHER_A_PAYPAL_EMAIL=sb-xxxx@personal.example.com
PUBLISHER_B_PAYPAL_EMAIL=sb-yyyy@personal.example.com

# --- AI (optional: without a key, deterministic fallbacks run) ---
LLM_PROVIDER=groq
GROQ_API_KEY=from-console.groq.com
LLM_MODEL=openai/gpt-oss-120b
# GEMINI_API_KEY=from-aistudio.google.com   (set LLM_PROVIDER=gemini to use Gemini instead)
